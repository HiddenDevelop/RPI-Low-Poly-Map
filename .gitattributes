* text=auto
*.py text eol=lf
*.md text eol=lf
*.json -text
*.blend binary
*.gpkg binary
*.shp binary
*.shx binary
*.dbf binary
*.tif binary
*.tiff binary

# Keep sealed source bytes unchanged across platforms.
gis/raw/** -text
gis/cleaned/** -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.laz filter=lfs diff=lfs merge=lfs -text
gis/acquisitions/** -text
